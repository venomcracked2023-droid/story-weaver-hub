# ==============================================================================
# CẤU HÌNH SUPABASE CÁ NHÂN
# Lấy các thông số này từ: Supabase Console -> Project Settings -> API / Connect
# ==============================================================================

# Project URL (ví dụ: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_URL="https://your-project-id.supabase.co"

# Anon / Publishable API Key
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key-here"
SUPABASE_PUBLISHABLE_KEY="your-anon-key-here"

# Project Reference ID (ví dụ: xyzcompany)
VITE_SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_PROJECT_ID="your-project-id"

# Service Role Secret Key (Tùy chọn: dùng cho các server function có quyền admin)
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"
